{
  "expo": {
    "name": "Retazo",
    "slug": "Retazo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      ["expo-location", { "locationWhenInUsePermission": "Retazo usa tu ubicación para centrar el mapa al registrar un lugar." }],
      ["expo-image-picker", { "photosPermission": "Retazo necesita acceder a tus fotos para adjuntar imágenes del lugar." }]
    ]
  }
}
